# 复制本文件为 .env 后填写。.env 已在 .gitignore 中，不会被提交。

# AI 服务：mock = 演示；coze = 传统 v3 API；coze_deploy = 新版部署服务 SSE
AI_PROVIDER=mock

# COZE_API_TOKEN：coze 使用 PAT；coze_deploy 使用部署页面生成的 API Token。
# COZE_BOT_ID 仅 coze 需要，coze_deploy 不使用。
COZE_API_TOKEN=
COZE_BOT_ID=

# 仅 AI_PROVIDER=coze_deploy 使用（填写部署页提供的信息；以下留空占位）
# COZE_DEPLOY_URL 取域名部分，不包含 /stream_run；例如 https://your-deployment.coze.site
# COZE_PROJECT_ID 取调用示例中的数字 project_id；不是 Bot ID。
COZE_DEPLOY_URL=
COZE_PROJECT_ID=

# 国内 API 地址（国际版对应 https://api.coze.com）
# PAT 需要 chat、getChat、listMessage 权限，并授权智能体所在空间。
# 以下一般不用改
COZE_API_BASE=https://api.coze.cn
# 以下仅为现有 v3 协议默认路径；新版扣子编程代码项目的调用格式待平台确认。
# 如平台确认其他地址，可配置基地址和各路径；这里只改变路由，不猜测其他协议。
COZE_CHAT_PATH=/v3/chat
COZE_RETRIEVE_PATH=/v3/chat/retrieve
COZE_MESSAGES_PATH=/v3/chat/message/list
COZE_TIMEOUT_SECONDS=90
DB_PATH=data/tasks.db

# 评测脚本（始终不加载 .env，不连接数据库）：
# .venv/bin/python scripts/eval_coze.py              # 默认离线，仅生成待执行报告
# .venv/bin/python scripts/eval_coze.py --live       # 仅在获批后真实调用
# --live 从进程环境变量 COZE_API_TOKEN 读取令牌；未设置则 getpass 隐藏输入。
# COZE_BOT_ID / COZE_API_BASE / COZE_*_PATH / COZE_TIMEOUT_SECONDS 同样由进程环境提供。
# 最多 10 次提取，依次调用、间隔 2 秒、失败不重试；报告写入 reports/。

# 新版部署服务建议先探测，后评测（以下 --live 命令仅由你确认后自行执行）：
# .venv/bin/python scripts/probe_deploy.py                  # 默认离线，不调用
# .venv/bin/python scripts/probe_deploy.py --live           # 只发一次固定测试请求
# .venv/bin/python scripts/eval_coze.py --provider coze_deploy --live
# 以上脚本均不读取 .env；需通过进程环境或探测脚本 --url / --project-id 设置配置。

# 智能办公助手 V5（第二周）：仅 scripts/eval_multiturn.py 使用，且只在走“扣子编程智能体”路径时需要。
# 脚本不读取 .env，只读进程环境变量；运行前先执行 set -a && source .env && set +a
# OFFICE_AGENT_URL 取部署域名，不包含 /stream_run
OFFICE_AGENT_URL=
OFFICE_AGENT_TOKEN=
OFFICE_PROJECT_ID=
